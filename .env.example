# Copy values into Replit Secrets. Never put these in frontend code.
AI_PROVIDER=openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1-mini
DAILY_AI_LIMIT_USD=50
PUBLIC_LIVE_AI=true
# Rolling one-hour API quota per workspace (shared through DATABASE_URL).
API_RATE_LIMIT_PER_HOUR=10000
ADMIN_TOKEN=
SESSION_SECRET=
# PostgreSQL recommended for a published deployment; SQLite is local-only.
# DATABASE_URL=postgresql://user:password@host/database
DEMO_MODE=true
# WhatsApp for kirana owners (docs/WHATSAPP.md). Direct Twilio webhook: set TWILIO_AUTH_TOKEN. Via n8n: set WHATSAPP_RELAY_TOKEN.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_RELAY_TOKEN=
WHATSAPP_NUMBER=
WHATSAPP_JOIN_CODE=
PUBLIC_BASE_URL=
