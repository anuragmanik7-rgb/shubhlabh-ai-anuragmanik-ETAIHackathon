{
  "description": "ShubhLabh AI on WhatsApp (Twilio Studio, no n8n): replies, photo reads and the full plan lane",
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "transitions": [
        {
          "event": "incomingMessage",
          "next": "ask_shubhlabh"
        },
        {
          "event": "incomingCall"
        },
        {
          "event": "incomingConversationMessage"
        },
        {
          "event": "incomingRequest"
        },
        {
          "event": "incomingParent"
        }
      ],
      "properties": {
        "offset": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "name": "ask_shubhlabh",
      "type": "make-http-request",
      "transitions": [
        {
          "event": "success",
          "next": "route_reply"
        },
        {
          "event": "failed",
          "next": "send_sorry"
        }
      ],
      "properties": {
        "method": "POST",
        "url": "https://relay:REPLACE_WITH_SHUBHLABH_RELAY_TOKEN@REPLACE_WITH_SHUBHLABH_HOST/api/v2/whatsapp/inbound?format=json&wait=7",
        "content_type": "application/x-www-form-urlencoded;charset=utf-8",
        "add_twilio_auth": false,
        "parameters": [
          {
            "key": "From",
            "value": "{{trigger.message.From}}"
          },
          {
            "key": "Body",
            "value": "{{trigger.message.Body}}"
          },
          {
            "key": "NumMedia",
            "value": "{{trigger.message.NumMedia}}"
          },
          {
            "key": "MediaUrl0",
            "value": "{{trigger.message.MediaUrl0}}"
          },
          {
            "key": "MediaContentType0",
            "value": "{{trigger.message.MediaContentType0}}"
          }
        ],
        "offset": {
          "x": 0,
          "y": 220
        }
      }
    },
    {
      "name": "route_reply",
      "type": "split-based-on",
      "transitions": [
        {
          "event": "noMatch",
          "next": "send_reply"
        },
        {
          "event": "match",
          "next": "start_plan",
          "conditions": [
            {
              "friendly_name": "If value equal_to plan",
              "arguments": [
                "{{widgets.ask_shubhlabh.parsed.intent}}"
              ],
              "type": "equal_to",
              "value": "plan"
            }
          ]
        },
        {
          "event": "match",
          "next": "send_reading",
          "conditions": [
            {
              "friendly_name": "If value equal_to pending",
              "arguments": [
                "{{widgets.ask_shubhlabh.parsed.intent}}"
              ],
              "type": "equal_to",
              "value": "pending"
            }
          ]
        }
      ],
      "properties": {
        "input": "{{widgets.ask_shubhlabh.parsed.intent}}",
        "offset": {
          "x": 0,
          "y": 460
        }
      }
    },
    {
      "name": "send_reply",
      "type": "send-message",
      "transitions": [
        {
          "event": "sent"
        },
        {
          "event": "failed"
        }
      ],
      "properties": {
        "from": "{{flow.channel.address}}",
        "to": "{{contact.channel.address}}",
        "body": "{{widgets.ask_shubhlabh.parsed.reply}}",
        "service": "{{trigger.message.InstanceSid}}",
        "channel": "{{trigger.message.ChannelSid}}",
        "offset": {
          "x": -560,
          "y": 720
        }
      }
    },
