      "properties": {
        "from": "{{flow.channel.address}}",
        "to": "{{contact.channel.address}}",
        "body": "🙏 Sorry, I could not answer just now. Please try again in a minute, or send *Hi* for the menu.\n🙏 Maaf kijiye, abhi jawaab nahi de paya. Ek minute baad dobara bhejiye.",
        "service": "{{trigger.message.InstanceSid}}",
        "channel": "{{trigger.message.ChannelSid}}",
        "offset": {
          "x": 520,
          "y": 220
        }
      }
